# ====================================================================
# RITU Big Data Weather Platform - Environment Variables Template
# ====================================================================

# Application Settings
PROJECT_NAME="RITU National Weather Big Data Platform"
VERSION="1.0.0"
DEBUG=False
ENVIRONMENT="production"

# NASA PPS Authentication & OpenSearch
NASA_USERNAME=techy.tron321@gmail.com
NASA_PASSWORD=techy.tron321@gmail.com
NASA_PPS_BASE_URL="https://jsimpsonhttps.pps.eosdis.nasa.gov"
NASA_OPENSEARCH_URL="https://pmmpublisher.pps.eosdis.nasa.gov/opensearch"
NASA_CMR_URL="https://cmr.earthdata.nasa.gov/search/granules.json"
EXPLABS_API_KEY=""

# Apache Kafka Broker (KRaft / Aiven Cloud / Local)
KAFKA_BOOTSTRAP_SERVERS="kafka-3b6fff-tatva-sih-2026.h.aivencloud.com:15321"
KAFKA_ENABLED=True
KAFKA_CLIENT_ID="ritu-weather-ingestor"
KAFKA_GROUP_ID="ritu-pipeline-group"
KAFKA_SECURITY_PROTOCOL="SASL_SSL"
KAFKA_SASL_MECHANISM="SCRAM-SHA-256"
KAFKA_SASL_USERNAME="avnadmin"
KAFKA_SASL_PASSWORD=""
KAFKA_SSL_CA_LOCATION="certs/ca.pem"

# PostgreSQL 16 + PostGIS Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ritu_db"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/ritu_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="ritu_db"

# Scheduler Settings
SCHEDULER_INTERVAL_MINUTES=30
SCHEDULER_ENABLED=True

# Spatial Bounds & Clipping Configuration (India Extent)
CLIP_TO_INDIA=True
INDIA_LAT_MIN=6.0
INDIA_LAT_MAX=37.5
INDIA_LON_MIN=68.0
INDIA_LON_MAX=97.5

# Performance and Concurrency
DOWNLOAD_TIMEOUT_SECONDS=300
MAX_CONCURRENT_DOWNLOADS=4
BULK_COPY_CHUNK_SIZE=50000
